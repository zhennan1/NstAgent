+def normalize_message_content(messages: List[Dict]) -> List[Dict]:
+    """把 AutoGen 产生的空占位消息转换成 vLLM 可接受的请求。
+
+    AutoGen 的顺序聊天会把没有正文的上一代理结果作为
+    ``{"role": "user", "content": None, "tool_calls": []}`` 传给下一代理。
+    OpenAI 客户端允许构造该对象，但 vLLM 的 Chat Completions schema
+    要求普通 user 消息的 content 必须是字符串或内容数组，因此直接返回
+    HTTP 400。空字符串保留原有轮次和 name，同时不凭空加入剧情信息。
+    """
+    normalized = copy.deepcopy(messages)
+    for message in normalized:
+        if (
+            message.get("content") is None
+            and not message.get("tool_calls")
+        ):
+            message["content"] = ""
+    return normalized
+
+
+def install_openai_wrapper_normalizer() -> None:
+    """在 AutoGen 最终发出请求前再次正规化消息。
+
+    ``TransformMessages`` 只处理 agent 当时已有的历史；AutoGen 的顺序聊天
+    会在 transform 执行后再插入上一个代理的空占位结果，因此仍可能把
+    ``content=None`` 交给 vLLM。包装 ``OpenAIWrapper.create`` 能覆盖所有
+    对话路径，同时只改变非法空内容，不改变角色、轮次或剧情信息。
+    """
+    if getattr(OpenAIWrapper.create, "_storywriter_normalized", False):
+        return
+    original_create = OpenAIWrapper.create
+
+    def normalized_create(self, **config):
+        config = dict(config)
+        messages = config.get("messages")
+        if isinstance(messages, list):
+            config["messages"] = normalize_message_content(messages)
+        if DISABLE_THINKING:
+            extra_body = dict(config.get("extra_body") or {})
+            chat_template_kwargs = dict(
+                extra_body.get("chat_template_kwargs") or {}
+            )
+            chat_template_kwargs["enable_thinking"] = False
+            extra_body["chat_template_kwargs"] = chat_template_kwargs
+            config["extra_body"] = extra_body
+        return original_create(self, **config)
+
+    normalized_create._storywriter_normalized = True
+    OpenAIWrapper.create = normalized_create
+
+
+install_openai_wrapper_normalizer()
+
+
+class NormalizeMessageContent:
+    """供所有 AutoGen 代理使用的轻量消息正规化 transform。"""
+
+    def apply_transform(self, messages: List[Dict]) -> List[Dict]:
+        return normalize_message_content(messages)
+
+    def get_logs(
+            self,
+            pre_transform_messages: List[Dict],
+            post_transform_messages: List[Dict],
+    ) -> Tuple[str, bool]:
+        changed = any(
+            before.get("content") != after.get("content")
+            for before, after in zip(
+                pre_transform_messages,
+                post_transform_messages,
+            )
+        )
+        return "normalized empty message content", changed
+
