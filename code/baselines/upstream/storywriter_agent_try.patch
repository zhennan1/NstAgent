+def _reformat_to_events(text, premise_hint=""):
+    """Fallback: ask the LLM to reformat free-form chat output into the
+    `Event N: ... Setting:{...} Character:{...} ...` template the regex
+    expects. Used when the strict pattern produces zero matches; without
+    this, sub_events agent receives an empty event_str and falls back to
+    the system-prompt demo (Annual Conference / Venue Selection)."""
+    from openai import OpenAI
+    client = OpenAI(
+        api_key=API_KEY,
+        base_url=url,
+        max_retries=CLIENT_MAX_RETRIES,
+    )
+    prompt = (
+        "You are given a draft story or outline. Re-emit ONLY a list of "
+        "5 to 10 plot events in this exact template (one per block, blank "
+        "line between blocks, no other text):\n"
+        "Event 1: {EVENT NAME}\n"
+        "Setting:{SETTING}\n"
+        "Character:{CHARACTER}\n"
+        "Action:{ACTION}\n"
+        "Conflict:{CONFLICT}\n"
+        "Plot Twist:{PLOT TWIST}\n"
+        "\n"
+        "Event 2: ...\n\n"
+        f"Premise (for grounding): {premise_hint}\n\n"
+        f"Draft to reformat:\n{text[:8000]}"
+    )
+    try:
+        request_options = {}
+        if DISABLE_THINKING:
+            request_options["extra_body"] = {
+                "chat_template_kwargs": {"enable_thinking": False}
+            }
+        resp = client.chat.completions.create(
+            model=MODEL,
+            messages=[{"role": "user", "content": prompt}],
+            max_tokens=MAX_TOKENS, temperature=0.7,
+            **request_options)
+        m = resp.choices[0].message
+        c = m.content or ""
+        if not c:
+            d = m.model_dump()
+            r = d.get("reasoning", "") or ""
+            c = r.split("</think>", 1)[-1] if "</think>" in r else r
+        return c
+    except Exception:
+        return ""
+
